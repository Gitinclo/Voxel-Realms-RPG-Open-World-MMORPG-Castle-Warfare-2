rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Bootstrapped Sovereign Admin / GM / Moderator Control (creatergame31@gmail.com)
    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.email == 'creatergame31@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: RealmSave
    function isValidRealmSaveShape(data) {
      return data.keys().hasAll([
          'ownerId',
          'lordName',
          'clanTag',
          'castleLevel',
          'cultivationRealmIndex',
          'cultivationLayer',
          'karmaValue',
          'powerRatingStr',
          'stateJson',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'lordName',
          'clanTag',
          'castleLevel',
          'cultivationRealmIndex',
          'cultivationLayer',
          'karmaValue',
          'powerRatingStr',
          'stateJson',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.lordName is string
        && data.lordName.size() >= 1
        && data.lordName.size() <= 60
        && data.clanTag is string
        && data.clanTag.size() >= 2
        && data.clanTag.size() <= 6
        && data.clanTag.matches('^[A-Z0-9]+$')
        && data.castleLevel is int
        && data.castleLevel >= 0
        && data.castleLevel <= 100
        && data.cultivationRealmIndex is int
        && data.cultivationRealmIndex >= 0
        && data.cultivationRealmIndex <= 22
        && data.cultivationLayer is int
        && data.cultivationLayer >= 1
        && data.cultivationLayer <= 9
        && data.karmaValue is int
        && data.karmaValue >= -1000000
        && data.karmaValue <= 1000000
        && data.powerRatingStr is string
        && data.powerRatingStr.size() >= 1
        && data.powerRatingStr.size() <= 64
        && data.stateJson is string
        && data.stateJson.size() >= 2
        && data.stateJson.size() <= 20000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRealmSave(data) {
      return isValidRealmSaveShape(data)
        && data.ownerId == request.auth.uid;
    }

    // Validation Blueprint: BattleChronicle
    function isValidBattleChronicleShape(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'summary',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'summary',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 2000
        && data.status is string
        && data.status.size() <= 16
        && (data.status == 'active' || data.status == 'archived')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBattleChronicle(data) {
      return isValidBattleChronicleShape(data)
        && data.ownerId == request.auth.uid;
    }

    // Validation Blueprint: SupportTicket (Direct Contact to creatergame31@gmail.com)
    function isValidSupportTicket(data) {
      return data.keys().hasAll([
          'ownerId',
          'senderName',
          'senderEmail',
          'recipientEmail',
          'category',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'senderName',
          'senderEmail',
          'recipientEmail',
          'category',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 80
        && data.senderEmail is string
        && data.senderEmail.size() >= 3
        && data.senderEmail.size() <= 120
        && data.recipientEmail is string
        && data.recipientEmail == 'creatergame31@gmail.com'
        && data.category is string
        && (data.category == 'gm_assistance'
          || data.category == 'moderation_appeal'
          || data.category == 'bug_report'
          || data.category == 'security_alert')
        && data.subject is string
        && data.subject.size() >= 1
        && data.subject.size() <= 140
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 2000
        && data.status is string
        && (data.status == 'open' || data.status == 'resolved')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isSignedIn()
        && isValidId(adminId)
        && (adminId == request.auth.uid || isAdmin());

      allow list: if isAdmin();

      allow create, update, delete: if false;
    }

    // Collection: /support_tickets/{ticketId}
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn()
        && isValidId(ticketId)
        && (isAdmin() || (resource != null && existing().ownerId == request.auth.uid));

      allow list: if isSignedIn()
        && (isAdmin() || existing().ownerId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(ticketId)
        && isValidSupportTicket(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(ticketId)
        && isValidSupportTicket(incoming())
        && existing().status != 'resolved'
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]);

      allow delete: if isAdmin()
        && isValidId(ticketId);
    }

    // Collection: /realm_saves/{saveId}
    match /realm_saves/{saveId} {
      allow get: if isSignedIn()
        && isValidId(saveId)
        && (isAdmin()
          || (saveId == request.auth.uid
            && (resource == null || existing().ownerId == request.auth.uid)));

      allow list: if isSignedIn()
        && (isAdmin() || existing().ownerId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(saveId)
        && saveId == request.auth.uid
        && isValidRealmSave(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(saveId)
        && ((saveId == request.auth.uid
            && isValidRealmSave(incoming())
            && existing().ownerId == request.auth.uid)
          || (isAdmin()
            && isValidRealmSaveShape(incoming())))
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lordName',
          'clanTag',
          'castleLevel',
          'cultivationRealmIndex',
          'cultivationLayer',
          'karmaValue',
          'powerRatingStr',
          'stateJson',
          'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(saveId)
        && ((saveId == request.auth.uid && existing().ownerId == request.auth.uid)
          || isAdmin());

      // Subcollection: /realm_saves/{saveId}/chronicles/{chronicleId}
      match /chronicles/{chronicleId} {
        allow get: if isSignedIn()
          && isValidId(saveId)
          && isValidId(chronicleId)
          && (isAdmin()
            || (saveId == request.auth.uid
              && existing().ownerId == request.auth.uid
              && get(/databases/$(database)/documents/realm_saves/$(saveId)).data.ownerId == request.auth.uid));

        allow list: if isSignedIn()
          && (isAdmin()
            || (saveId == request.auth.uid && existing().ownerId == request.auth.uid));

        allow create: if isSignedIn()
          && isValidId(saveId)
          && isValidId(chronicleId)
          && saveId == request.auth.uid
          && isValidBattleChronicle(incoming())
          && incoming().status == 'active'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/realm_saves/$(saveId)).data.ownerId == request.auth.uid;

        allow update: if isSignedIn()
          && isValidId(saveId)
          && isValidId(chronicleId)
          && ((saveId == request.auth.uid
              && isValidBattleChronicle(incoming())
              && existing().ownerId == request.auth.uid
              && get(/databases/$(database)/documents/realm_saves/$(saveId)).data.ownerId == request.auth.uid)
            || (isAdmin()
              && isValidBattleChronicleShape(incoming())))
          && existing().status != 'archived'
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'summary',
            'status',
            'updatedAt'
          ]);

        allow delete: if isSignedIn()
          && isValidId(saveId)
          && isValidId(chronicleId)
          && (isAdmin()
            || (saveId == request.auth.uid
              && existing().ownerId == request.auth.uid
              && get(/databases/$(database)/documents/realm_saves/$(saveId)).data.ownerId == request.auth.uid));
      }
    }
  }
}
