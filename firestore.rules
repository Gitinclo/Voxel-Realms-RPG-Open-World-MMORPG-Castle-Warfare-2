rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: RealmSave
    function isValidRealmSave(data) {
      return data.keys().hasAll([
          'ownerId',
          'lordName',
          'clanTag',
          'castleLevel',
          'cultivationRealmIndex',
          'cultivationLayer',
          'karmaValue',
          'powerRatingStr',
          'stateJson',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'lordName',
          'clanTag',
          'castleLevel',
          'cultivationRealmIndex',
          'cultivationLayer',
          'karmaValue',
          'powerRatingStr',
          'stateJson',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.lordName is string
        && data.lordName.size() >= 1
        && data.lordName.size() <= 60
        && data.clanTag is string
        && data.clanTag.size() >= 2
        && data.clanTag.size() <= 6
        && data.clanTag.matches('^[A-Z0-9]+$')
        && data.castleLevel is int
        && data.castleLevel >= 0
        && data.castleLevel <= 100
        && data.cultivationRealmIndex is int
        && data.cultivationRealmIndex >= 0
        && data.cultivationRealmIndex <= 22
        && data.cultivationLayer is int
        && data.cultivationLayer >= 1
        && data.cultivationLayer <= 9
        && data.karmaValue is int
        && data.karmaValue >= -1000000
        && data.karmaValue <= 1000000
        && data.powerRatingStr is string
        && data.powerRatingStr.size() >= 1
        && data.powerRatingStr.size() <= 64
        && data.stateJson is string
        && data.stateJson.size() >= 2
        && data.stateJson.size() <= 20000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: BattleChronicle
    function isValidBattleChronicle(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'summary',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'summary',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 2000
        && data.status is string
        && data.status.size() <= 16
        && (data.status == 'active' || data.status == 'archived')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /realm_saves/{saveId}
    match /realm_saves/{saveId} {
      allow get: if isSignedIn()
        && isValidId(saveId)
        && saveId == request.auth.uid
        && (resource == null || existing().ownerId == request.auth.uid);

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(saveId)
        && saveId == request.auth.uid
        && isValidRealmSave(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(saveId)
        && saveId == request.auth.uid
        && isValidRealmSave(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lordName',
          'clanTag',
          'castleLevel',
          'cultivationRealmIndex',
          'cultivationLayer',
          'karmaValue',
          'powerRatingStr',
          'stateJson',
          'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(saveId)
        && saveId == request.auth.uid
        && existing().ownerId == request.auth.uid;

      // Subcollection: /realm_saves/{saveId}/chronicles/{chronicleId}
      match /chronicles/{chronicleId} {
        allow get: if isSignedIn()
          && isValidId(saveId)
          && isValidId(chronicleId)
          && saveId == request.auth.uid
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/realm_saves/$(saveId)).data.ownerId == request.auth.uid;

        allow list: if isSignedIn()
          && saveId == request.auth.uid
          && existing().ownerId == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(saveId)
          && isValidId(chronicleId)
          && saveId == request.auth.uid
          && isValidBattleChronicle(incoming())
          && incoming().status == 'active'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/realm_saves/$(saveId)).data.ownerId == request.auth.uid;

        allow update: if isSignedIn()
          && isValidId(saveId)
          && isValidId(chronicleId)
          && saveId == request.auth.uid
          && isValidBattleChronicle(incoming())
          && existing().ownerId == request.auth.uid
          && existing().status != 'archived'
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'summary',
            'status',
            'updatedAt'
          ])
          && get(/databases/$(database)/documents/realm_saves/$(saveId)).data.ownerId == request.auth.uid;

        allow delete: if isSignedIn()
          && isValidId(saveId)
          && isValidId(chronicleId)
          && saveId == request.auth.uid
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/realm_saves/$(saveId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
